### 3.7 Addon Preferences
Location: Edit > Preferences > Add-ons > Audio2Face

Properties:
- api_key: StringProperty(subtype='PASSWORD')
- function_id: StringProperty(default="<nvidia-cloud-function-id>")
- default_server_url: StringProperty(default="localhost:52000")
- connection_mode: EnumProperty('CLOUD', 'LOCAL')
- auto_create_shapekeys: BoolProperty(default=True)
- default_model: EnumProperty('james_v2.3', 'claire_v2.3', 'mark_v2.3')
- log_level: EnumProperty('ERROR', 'WARNING', 'INFO', 'DEBUG')

